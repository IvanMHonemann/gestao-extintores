# Runtime
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# MySQL/TiDB used by the application. Prefer this name outside Manus.
EXTERNAL_DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}

# false = no Manus dependency; true only when Forge/OAuth are configured.
MANUS_INTEGRATIONS=false

# Optional S3-compatible storage: AWS S3, Cloudflare R2, MinIO, Backblaze, etc.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Optional direct Google Maps JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=

# Only needed with MANUS_INTEGRATIONS=true.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
