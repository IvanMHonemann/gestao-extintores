{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "corepack enable && pnpm install",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/healthz", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  }
}
